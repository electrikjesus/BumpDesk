# Copy this file to keystore.properties (gitignored) for local signed release builds.
#
# Generate the release keystore once (keep the .jks file backed up outside the repo):
#   mkdir -p keystore
#   keytool -genkeypair -v \
#     -keystore keystore/bumpdesk-release.jks \
#     -alias bumpdesk \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype JKS
#
# GitHub Actions: base64-encode the keystore and store as SIGNING_KEY, plus the
# three password/alias secrets listed in .github/workflows/create_release.yml.

storeFile=keystore/bumpdesk-release.jks
storePassword=CHANGE_ME
keyAlias=bumpdesk
keyPassword=CHANGE_ME
