<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_settings_back"
            app:navigationIconTint="@color/m3_on_surface"
            app:title="@string/settings_title"
            app:titleCentered="false"
            app:titleTextAppearance="@style/TextAppearance.BumpDesk.Settings.Label" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp">

            <TextView
                style="@style/TextAppearance.BumpDesk.Settings.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="@string/settings_headline" />

            <!-- Desktop type -->
            <TextView
                style="@style/TextAppearance.BumpDesk.Settings.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_section_desktop" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BumpDesk.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.BumpDesk.Settings.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/settings_desktop_hint" />

                    <LinearLayout
                        android:id="@+id/desktopOptionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Apps & recents -->
            <TextView
                style="@style/TextAppearance.BumpDesk.Settings.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_section_apps" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BumpDesk.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchShowRecentApps"
                        style="@style/Widget.BumpDesk.Settings.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/settings_show_recents" />

                    <TextView
                        style="@style/TextAppearance.BumpDesk.Settings.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/settings_recents_view_label" />

                    <RadioGroup
                        android:id="@+id/rgRecentsViewMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbRecentsIcons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_recents_view_icons" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbRecentsTaskCards"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_recents_view_cards" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tvRecentsSnapshotStatus"
                        style="@style/TextAppearance.BumpDesk.Settings.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:textSize="13sp" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchShowAppDrawerIcon"
                        style="@style/Widget.BumpDesk.Settings.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/settings_show_all_apps" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchRememberLaunchMode"
                        style="@style/Widget.BumpDesk.Settings.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/settings_remember_launch_mode" />

                    <TextView
                        style="@style/TextAppearance.BumpDesk.Settings.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/settings_default_launch_mode" />

                    <RadioGroup
                        android:id="@+id/rgDefaultLaunchMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbLaunchStandard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_launch_standard" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbLaunchMaximized"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_launch_maximized" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbLaunchPortrait"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_launch_portrait" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbLaunchFullscreen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_launch_fullscreen" />
                    </RadioGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_launch_scale" />

                        <TextView
                            android:id="@+id/tvLaunchScaleVal"
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/m3_primary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderLaunchScale"
                        style="@style/Widget.BumpDesk.Settings.Slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:stepSize="5"
                        android:value="100"
                        android:valueFrom="50"
                        android:valueTo="150" />

                    <LinearLayout
                        android:id="@+id/groupWallpaperFloor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchUseWallpaperAsFloor"
                            style="@style/Widget.BumpDesk.Settings.Switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/settings_wallpaper_floor" />

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/settings_wallpaper_floor_hint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Appearance -->
            <TextView
                style="@style/TextAppearance.BumpDesk.Settings.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_section_appearance" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BumpDesk.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.BumpDesk.Settings.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/settings_theme_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangeTheme"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_select_theme" />

                    <LinearLayout
                        android:id="@+id/groupExpressiveFolderChrome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchExpressiveM3FolderChrome"
                            style="@style/Widget.BumpDesk.Settings.Switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/settings_expressive_m3_folder_chrome" />

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/settings_expressive_m3_folder_chrome_hint" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        style="@style/TextAppearance.BumpDesk.Settings.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/settings_radial_menu_size_label" />

                    <RadioGroup
                        android:id="@+id/rgRadialMenuSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbRadialMenuAuto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_radial_menu_size_auto" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbRadialMenuPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_radial_menu_size_phone" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbRadialMenuTablet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_radial_menu_size_tablet" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbRadialMenuLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_radial_menu_size_large" />
                    </RadioGroup>

                    <TextView
                        style="@style/TextAppearance.BumpDesk.Settings.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/settings_radial_menu_size_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Physics -->
            <TextView
                style="@style/TextAppearance.BumpDesk.Settings.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_section_physics" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BumpDesk.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_friction" />

                        <TextView
                            android:id="@+id/tvFrictionVal"
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/m3_primary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderFriction"
                        style="@style/Widget.BumpDesk.Settings.Slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="94"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_bounciness" />

                        <TextView
                            android:id="@+id/tvBouncinessVal"
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/m3_primary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBounciness"
                        style="@style/Widget.BumpDesk.Settings.Slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="25"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_gravity" />

                        <TextView
                            android:id="@+id/tvGravityVal"
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/m3_primary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderGravity"
                        style="@style/Widget.BumpDesk.Settings.Slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="10"
                        android:valueFrom="0"
                        android:valueTo="100" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Layout -->
            <TextView
                style="@style/TextAppearance.BumpDesk.Settings.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_section_layout" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BumpDesk.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_item_scale" />

                        <TextView
                            android:id="@+id/tvItemScaleVal"
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/m3_primary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderItemScale"
                        style="@style/Widget.BumpDesk.Settings.Slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="50"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_grid_spacing" />

                        <TextView
                            android:id="@+id/tvGridSpacingVal"
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/m3_primary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderGridSpacing"
                        style="@style/Widget.BumpDesk.Settings.Slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="60"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.BumpDesk.Settings.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_room_size" />

                        <TextView
                            android:id="@+id/tvRoomSizeVal"
                            style="@style/TextAppearance.BumpDesk.Settings.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/m3_primary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRoomSize"
                        style="@style/Widget.BumpDesk.Settings.Slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="30"
                        android:valueFrom="0"
                        android:valueTo="100" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Maintenance -->
            <TextView
                style="@style/TextAppearance.BumpDesk.Settings.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_section_maintenance" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BumpDesk.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetCamera"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reset_camera" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetDesktopLayout"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reset_desktop_layout" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearCache"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_clear_cache" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetDefaults"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reset_all"
                        android:textColor="@color/m3_error" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnApplyChanges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/settings_save_apply"
        app:icon="@drawable/ic_settings_check_circle"
        app:iconTint="@color/m3_on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
